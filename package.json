{
  "name": "verbagather-share",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "VerbaGather — 英语四六级学习站（单词 / 句子 / 作文）",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"node --watch-path=server server/index.mjs\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "node --watch-path=server server/index.mjs",
    "build": "npm run check && node scripts/prepare-ocr.mjs && vite build",
    "check": "tsc --noEmit -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "preview": "npm run build && npm start",
    "content:check": "node scripts/validate-content.mjs",
    "test": "node --test tests/srs.test.mjs tests/quiz.test.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tanstack/react-query": "5.104.5",
    "clsx": "2.1.1",
    "express": "5.3.0",
    "lucide-react": "1.61.0",
    "mammoth": "1.13.0",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "22.19.0",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.11",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "10.0.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.13"
  }
}
